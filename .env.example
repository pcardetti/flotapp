# Copiá este archivo como .env.local y completá los valores de Supabase
# (Supabase → Project Settings → API). Nunca subas .env.local al repositorio.
NEXT_PUBLIC_SUPABASE_URL=
# La clave pública: Supabase la llama "publishable key" (antes "anon key").
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Dirección pública de la app. En tu PC: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: CAPTCHA de Cloudflare Turnstile. Es la clave de sitio (pública); la secreta va en Supabase, no acá.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Sólo en el servidor (sin NEXT_PUBLIC_): nunca llegan al navegador ──
# Firma las claves del límite de intentos. 32 caracteres o más al azar.
FLOTAPP_SECRETO_LIMITES=

# ── Cobros con Mercado Pago (Suscripciones) ──
# Access Token de tu aplicación (Mercado Pago Developers → Tus integraciones → Credenciales).
MP_ACCESS_TOKEN=
# Clave secreta de los webhooks (Tus integraciones → Webhooks, eventos "Planes y suscripciones" y "Pagos").
# Dirección de los avisos: /api/pagos/mercadopago
MP_WEBHOOK_SECRET=
# Secreto que comparte la app con la base para anotar pagos. Lo genera la migración 0006:
# en Supabase → SQL Editor: select valor from secretos where clave = 'pagos';
FLOTAPP_SECRETO_PAGOS=
